# Local service URLs
NEXT_PUBLIC_IMMICH_URL=urlgoeshere
NEXT_PUBLIC_PLEX_URL=urlgoeshere
NEXT_PUBLIC_HOME_ASSISTANT_URL=urlgoeshere
NEXT_PUBLIC_PROTECT_URL=urlgoeshere
NEXT_PUBLIC_FORGEJO_URL=urlgoeshere

# Paradise API Configuration
# Base URL for the Java Spring Boot backend API
# The backend listens on port 8180 (server.port in paradise-be application.properties).
# If unset, requests go to the frontend's own origin, which only works behind a proxy.
NEXT_PUBLIC_PARADISE_API_BASE_URL=http://localhost:8180